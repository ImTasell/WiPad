import { Button } from "std-widgets.slint";

export component MainWindow inherits Window {
    in-out property <string> discovery-status: "Starting LAN discovery…";
    in-out property <bool> pairing-pending: false;
    in-out property <string> pairing-peer: "";
    in-out property <string> pairing-code: "";
    callback approve-pairing();
    callback reject-pairing();

    title: "WiPad";
    preferred-width: 560px;
    preferred-height: 420px;
    background: #0d1b2a;

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 32px;

        Text {
            text: "WiPad";
            color: #eaf4ff;
            font-size: 32px;
            font-weight: 700;
        }

        Text {
            text: "Linux controller bridge";
            color: #b8cde0;
            font-size: 16px;
        }

        Rectangle {
            background: #14283b;
            border-radius: 12px;
            min-width: 340px;

            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text {
                    text: "Network: " + root.discovery-status;
                    color: #80deea;
                    wrap: word-wrap;
                }
                Text {
                    text: "Virtual gamepad: Not created";
                    color: #b8cde0;
                }
            }
        }

        if root.pairing-pending: Rectangle {
            background: #18384a;
            border-radius: 12px;
            min-width: 340px;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text {
                    text: "Approve first connection";
                    color: #eaf4ff;
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: root.pairing-peer + " wants to pair";
                    color: #b8cde0;
                }
                Text {
                    text: root.pairing-code;
                    color: #4dd0e1;
                    font-size: 24px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Compare this code with the phone before approving.";
                    color: #b8cde0;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 12px;
                    Button {
                        text: "Approve";
                        clicked => { root.approve-pairing(); }
                    }
                    Button {
                        text: "Reject";
                        clicked => { root.reject-pairing(); }
                    }
                }
            }
        }

        Text {
            text: "LAN discovery is active. Peer discovery does not establish trust.";
            color: #90a4b8;
            font-size: 13px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
