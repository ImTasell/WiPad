export component MainWindow inherits Window {
    in-out property <string> discovery-status: "Starting LAN discovery…";

    title: "WiPad";
    preferred-width: 560px;
    preferred-height: 420px;
    background: #0d1b2a;

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 32px;

        Text {
            text: "WiPad";
            color: #eaf4ff;
            font-size: 32px;
            font-weight: 700;
        }

        Text {
            text: "Linux controller bridge";
            color: #b8cde0;
            font-size: 16px;
        }

        Rectangle {
            background: #14283b;
            border-radius: 12px;
            min-width: 340px;

            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text {
                    text: "Network: " + root.discovery-status;
                    color: #80deea;
                    wrap: word-wrap;
                }
                Text {
                    text: "Virtual gamepad: Not created";
                    color: #b8cde0;
                }
            }
        }

        Text {
            text: "LAN discovery is active. Peer discovery does not establish trust.";
            color: #90a4b8;
            font-size: 13px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
